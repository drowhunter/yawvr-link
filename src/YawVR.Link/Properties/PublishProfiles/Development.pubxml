<Project>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <PackageOutputPath>D:\Nuget</PackageOutputPath>
    <PackageVersion Condition="'$(PackageVersion)' == ''">$(Version)-dev</PackageVersion>
  </PropertyGroup>

  <Target Name="PackDevelopmentPackage"
          AfterTargets="Publish"
          DependsOnTargets="Pack"
          Condition="'$(Configuration)' == 'Debug'" />
</Project>
